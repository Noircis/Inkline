{
  "name": "inkline",
  "version": "2.12.0",
  "description": "Music notebook for Android: text, staves, rhythms and chord charts (offline PWA).",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && node --test tests/*.test.js",
    "docs": "jsdoc -c jsdoc.json",
    "dev": "node scripts/dev.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.13.0",
    "@playwright/test": "1.63.0",
    "docdash": "2.0.2",
    "eslint": "9.13.0",
    "fake-indexeddb": "6.0.0",
    "globals": "15.11.0",
    "jsdoc": "4.0.4",
    "prettier": "3.3.3"
  }
}
